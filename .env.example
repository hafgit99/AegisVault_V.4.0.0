# Aegis Desktop local development settings
# Copy to .env for local development only. Never package or commit real secrets.

# Native host is the preferred desktop-extension bridge.
# Enable loopback only when explicitly testing the HTTP fallback.
AEGIS_ENABLE_LOOPBACK_SYNC=0

# Use a unique, randomly generated value with at least 32 characters when loopback is enabled.
AEGIS_EXTENSION_PAIRING_SECRET=

# Comma-separated extension IDs allowed to pair with this desktop app.
AEGIS_EXTENSION_ID=
AEGIS_EXTENSION_ALLOWLIST=

# Keep strict allowlist mode enabled outside short-lived compatibility tests.
AEGIS_STRICT_ALLOWLIST_MODE=1
