{
  "$schema": "https://stryker-mutator.io/report/stryker-config.schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress", "json"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "testFiles": [
    "src/vaultService.test.ts",
    "src/vaultService.coverage.test.ts",
    "src/lib/__tests__/VaultService_Migration.test.ts",
    "src/lib/__tests__/ExtensionBridge.test.ts",
    "src/lib/__tests__/ExtensionBridge.branch.test.ts",
    "src/lib/__tests__/PasskeyBindingService.test.ts",
    "src/lib/__tests__/PasskeyBindingService.branch.test.ts",
    "src/lib/__tests__/SQLiteOPFS.test.ts",
    "src/lib/__tests__/WebAuthnService.test.ts",
    "src/lib/__tests__/WebAuthnService_Logic.test.ts",
    "src/lib/__tests__/webAuthn_utils.test.ts",
    "src/lib/__tests__/RecoveryDrillService.test.ts",
    "src/lib/wallet/__tests__/CryptoWalletVault.test.ts"
  ],
  "mutate": [
    "src/vaultService.ts",
    "src/lib/ExtensionBridge.ts",
    "src/lib/webAuthn.ts",
    "src/lib/WebAuthnService.ts",
    "src/lib/SQLiteOPFS.ts",
    "src/lib/PasskeyBindingService.ts",
    "src/lib/RecoveryDrillService.ts",
    "src/lib/wallet/CryptoWalletVault.ts"
  ],
  "coverageAnalysis": "all",
  "thresholds": {
    "high": 80,
    "low": 50,
    "break": 0
  }
}
